# macOS / Linux: 호스트 절대 경로를 사용합니다.
DATA_ROOT_PATH=/absolute/path/datasets
# 선택 사항. 생략하면 DATA_ROOT_PATH를 썸네일 볼륨으로 사용합니다.
THUMBNAIL_ROOT_PATH=/absolute/path/thumbnails
SELECTED_DATA_PATH=/absolute/path/prework-runtime/selected
APP_DATA_PATH=/absolute/path/prework-runtime/app-data

# Windows 예시: Windows에서 실행할 때 위의 경로 값을 다음 형식으로 변경합니다.
# DATA_ROOT_PATH=D:/datasets
# SELECTED_DATA_PATH=C:/Users/username/upcycling-prework-runtime/selected
# APP_DATA_PATH=C:/Users/username/upcycling-prework-runtime/app-data
# 슬래시(/)를 사용하고, 경로의 공백 앞에는 백슬래시(\)를 붙이지 않습니다.

PREWORK_FRONTEND_PORT=18081
PREWORK_BACKEND_PORT=18000
